{
  "name": "pi-ticket-planning",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Profile-only PI package for routing product evidence into committed releases, delivery tickets, and independent ticket admission.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Notyet1307/pi-ticket-planning.git"
  },
  "homepage": "https://github.com/Notyet1307/pi-ticket-planning#readme",
  "bugs": {
    "url": "https://github.com/Notyet1307/pi-ticket-planning/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "admit": "node scripts/admit.mjs",
    "check": "node scripts/check-package.mjs",
    "check:admission-state": "node scripts/check-admission-state.mjs",
    "check:delivery-graph": "node scripts/check-delivery-graph.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:frontier": "node scripts/check-frontier-order.mjs",
    "check:ticket-context": "node scripts/check-ticket-context.mjs",
    "check:behavior-fixtures": "node scripts/check-behavior-fixtures.mjs",
    "check:profile": "node scripts/check-profile.mjs",
    "check:workflow": "node scripts/workflow-contract.mjs",
    "canary:execution-readiness": "node scripts/canary-execution-readiness.mjs",
    "doctor": "node scripts/doctor.mjs",
    "delivery-gate": "node scripts/delivery-gate.mjs",
    "eval:pi": "node scripts/eval-pi-behavior.mjs",
    "eval:pi:nightly": "node scripts/eval-pi-behavior.mjs --suite nightly --repeat 3 --report-only",
    "install:profile": "node scripts/install-profile.mjs",
    "planctl": "node scripts/planctl.mjs",
    "test": "node --test test/*.test.mjs",
    "test:state": "node --test test/planning-case.test.mjs test/planctl.test.mjs",
    "verify:ci": "npm run check && npm run verify:protocol && npm run check:behavior-fixtures && npm run check:docs && npm test",
    "verify:protocol": "node scripts/verify-protocol.mjs",
    "verify": "npm run verify:ci && npm run check:profile",
    "verify:release": "npm run verify && npm run eval:pi -- --suite release --retry-failures 1 --require-clean"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "mattpocockUpstream": {
    "repository": "https://github.com/mattpocock/skills.git",
    "commit": "84fdeffd12f2ee307994d1eb6feb48173b6e0502",
    "stableTagAtCreation": "v1.2.3",
    "updatePolicy": "manual"
  }
}
