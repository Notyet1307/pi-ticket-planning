{
  "schema": "pi-ticket-planning:workflow:v1",
  "version": 1,
  "lanes": ["PRODUCT", "DELIVERY", "TRIAGE", "RISK", "INCIDENT"],
  "identityPatterns": {
    "none": "^NONE$",
    "release": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
    "ticket": "^[^@\\s]+@[^@\\s]+$"
  },
  "stages": {
    "ORIENT": {
      "identityKinds": ["none", "release", "ticket"],
      "verdicts": ["NEEDS_TARGET", "ROUTED"]
    },
    "FRAME": {
      "identityKinds": ["none", "release"],
      "verdicts": ["FRAME_CANDIDATE", "FRAME_WRITE_AWAITING_APPROVAL"]
    },
    "EVIDENCE": {
      "identityKinds": ["release"],
      "verdicts": ["NEEDS_RESEARCH", "NEEDS_PROTOTYPE", "NEEDS_DECISION", "EVIDENCE_WRITE_AWAITING_APPROVAL", "EVIDENCE_AUTHORIZED", "INTERVIEW_AWAITING_CONSENT", "INTERVIEW_IN_PROGRESS", "INTERVIEW_RECORDED", "INTERVIEW_STOPPED", "EVIDENCE_RECORDED"]
    },
    "COMMIT": {
      "identityKinds": ["release"],
      "verdicts": ["NOT_READY", "READY_TO_COMMIT", "COMMITTED", "HOLD", "REWORK", "DROP"]
    },
    "SPEC": {
      "identityKinds": ["release"],
      "verdicts": ["PLANNED", "SPEC_IN_PROGRESS", "SPEC_ACCEPTED", "BLOCKED"]
    },
    "TICKETS": {
      "identityKinds": ["release", "ticket"],
      "verdicts": ["TICKET_GRAPH_CANDIDATE", "TICKETS_ACCEPTED", "ORACLES_BOUND", "GRAPH_REVIEWED", "BLOCKED"]
    },
    "ADMISSION": {
      "identityKinds": ["release", "ticket"],
      "verdicts": ["REVIEW_IN_PROGRESS", "ACTIVATION_AWAITING_CONFIRMATION", "ADMITTED", "HANDOFF_APPROVED", "BLOCKED"]
    },
    "EXECUTION": {
      "identityKinds": ["release", "ticket"],
      "verdicts": ["HANDOFF_READY", "IN_PROGRESS", "BLOCKED", "DELIVERED"]
    },
    "OUTCOME": {
      "identityKinds": ["release"],
      "verdicts": ["AWAITING_EVIDENCE", "ACHIEVED", "PARTIAL", "NOT_ACHIEVED", "UNEVALUABLE"]
    }
  },
  "allowedTransitions": {
    "ORIENT": ["ORIENT", "FRAME", "EVIDENCE", "COMMIT", "SPEC", "TICKETS", "ADMISSION", "EXECUTION", "OUTCOME"],
    "FRAME": ["FRAME", "EVIDENCE", "COMMIT"],
    "EVIDENCE": ["FRAME", "EVIDENCE", "COMMIT"],
    "COMMIT": ["FRAME", "EVIDENCE", "COMMIT", "SPEC"],
    "SPEC": ["COMMIT", "SPEC", "TICKETS"],
    "TICKETS": ["SPEC", "TICKETS", "ADMISSION"],
    "ADMISSION": ["TICKETS", "ADMISSION", "EXECUTION"],
    "EXECUTION": ["ADMISSION", "EXECUTION", "OUTCOME"],
    "OUTCOME": ["OUTCOME", "ORIENT", "FRAME"]
  },
  "transitionRequirements": [
    {
      "sourceStage": "COMMIT",
      "sourceVerdict": "HOLD",
      "sameRelease": true,
      "targetStages": ["FRAME", "EVIDENCE"],
      "requiredFacts": ["release.reopenConditionMet", "human.releaseReopened"]
    },
    {
      "sourceStage": "COMMIT",
      "sourceVerdict": "REWORK",
      "sameRelease": true,
      "targetStages": ["FRAME", "EVIDENCE"],
      "requiredFacts": ["release.reworkActionRecorded"]
    }
  ],
  "rebindTransitions": [
    {
      "sourceStage": "ORIENT",
      "targetStage": "FRAME",
      "requiredFacts": ["human.targetSelected"],
      "changes": ["subject.kind", "subject.id", "subject.revision"]
    },
    {
      "sourceStage": "OUTCOME",
      "targetStage": "ORIENT",
      "requiredFacts": ["human.identityRebind"],
      "changes": ["subject.id", "subject.revision"]
    }
  ],
  "verdictRequirements": {
    "EVIDENCE_RECORDED": ["evidence.persisted"],
    "READY_TO_COMMIT": ["release.readinessPassed"],
    "COMMITTED": ["release.readinessPassed", "human.commitment", "release.persisted"],
    "PLANNED": ["release.persisted"],
    "HOLD": ["human.releaseDecision", "release.persisted"],
    "REWORK": ["human.releaseDecision", "release.persisted"],
    "DROP": ["human.releaseDecision", "release.persisted"],
    "SPEC_IN_PROGRESS": ["human.commitment", "release.persisted", "release.accepted", "git.deliveryBase"],
    "SPEC_ACCEPTED": ["human.commitment", "release.persisted", "release.accepted", "git.deliveryBase", "spec.persisted"],
    "TICKETS_ACCEPTED": ["spec.persisted", "tickets.persisted", "graph.passed", "human.graphApproval"],
    "ORACLES_BOUND": ["spec.persisted", "oracles.bound"],
    "GRAPH_REVIEWED": ["spec.persisted", "oracles.bound", "graph.passed", "review.ready"],
    "REVIEW_IN_PROGRESS": ["tickets.persisted", "graph.passed"],
    "ACTIVATION_AWAITING_CONFIRMATION": ["source.unchanged", "policy.accepted", "review.ready"],
    "ADMITTED": ["source.unchanged", "policy.accepted", "review.ready", "human.activation", "tracker.ready"],
    "HANDOFF_APPROVED": ["source.unchanged", "policy.accepted", "graph.passed", "review.ready", "executionPlan.validated", "handoff.approved"],
    "HANDOFF_READY": ["execution.handoffReady"],
    "IN_PROGRESS": ["harness.active"],
    "DELIVERED": ["harness.terminalSuccess", "git.acceptedSource"],
    "AWAITING_EVIDENCE": ["release.recorded", "release.enabled", "release.smokePassed"],
    "ACHIEVED": ["outcome.windowElapsed", "outcome.evidence"],
    "PARTIAL": ["outcome.windowElapsed", "outcome.evidence"],
    "NOT_ACHIEVED": ["outcome.windowElapsed", "outcome.evidence"],
    "UNEVALUABLE": ["outcome.windowElapsed", "outcome.evidence"]
  }
}
