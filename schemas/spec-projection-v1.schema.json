{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/spec-projection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "id", "revision", "baseSha", "source", "scenarioIds", "contentDigest", "acceptance"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:spec-projection:v1" },
    "target": { "$ref": "common-v1.schema.json#/$defs/target" },
    "id": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "revision": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "baseSha": { "$ref": "common-v1.schema.json#/$defs/gitSha" },
    "source": { "$ref": "common-v1.schema.json#/$defs/subject" },
    "scenarioIds": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "pattern": "^S[1-9][0-9]*$" } },
    "contentDigest": { "$ref": "common-v1.schema.json#/$defs/digest" },
    "acceptance": { "$ref": "spec-acceptance-v1.schema.json" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "digest"],
      "properties": {
        "kind": { "const": "GITHUB_ISSUE" },
        "ref": { "type": "string", "pattern": "^repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$" },
        "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
      }
    }
  }
}
