{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/github-app-credential-binding-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "action", "appSlug", "installationId", "targetRepo", "permissions", "tokenBinding"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:github-app-credential-binding:v1" },
    "action": { "const": "actions/create-github-app-token@v3" },
    "appSlug": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$" },
    "installationId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "targetRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "permissions": { "const": ["issues:write", "metadata:read"] },
    "tokenBinding": { "$ref": "common-v1.schema.json#/$defs/digest" }
  }
}
