{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/producer-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sources"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:producer-registry:v1" },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "producers"],
        "properties": {
          "kind": { "enum": ["command", "module", "skill"] },
          "command": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
          "producers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
