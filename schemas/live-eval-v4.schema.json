{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/live-eval-v4.schema.json",
  "allOf": [{ "$ref": "report-metadata-v1.schema.json" }],
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schema", "source", "fixtureSha256", "caseSetSha256", "fixtureCaseIds", "caseCount", "modelTurns", "toolCalls", "contextTokens", "totalTokens", "forbiddenWrites", "cleanupFailures", "caseTypes", "suite", "repeat", "retryFailures", "startedAt", "finishedAt", "attempts", "summary", "gate"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:live-eval:v4" },
    "tier": { "const": "L2_REAL_MODEL" },
    "source": { "type": "object", "additionalProperties": false, "required": ["revision", "dirty"], "properties": { "revision": { "$ref": "common-v1.schema.json#/$defs/gitSha" }, "dirty": { "type": "boolean" } } },
    "fixtureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "caseSetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fixtureCaseIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "caseCount": { "type": "integer", "minimum": 1 },
    "modelTurns": { "type": "integer", "minimum": 1 },
    "toolCalls": { "type": "integer", "minimum": 0 },
    "contextTokens": { "type": "integer", "minimum": 0 },
    "totalTokens": { "type": "integer", "minimum": 0 },
    "forbiddenWrites": { "type": "integer", "minimum": 0 },
    "cleanupFailures": { "type": "integer", "minimum": 0 },
    "caseTypes": { "type": "array", "items": { "type": "object" } },
    "suite": { "type": "string", "minLength": 1 },
    "repeat": { "type": "integer", "minimum": 1 },
    "retryFailures": { "type": "integer", "minimum": 0 },
    "startedAt": { "$ref": "common-v1.schema.json#/$defs/time" },
    "finishedAt": { "$ref": "common-v1.schema.json#/$defs/time" },
    "attempts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attempt" } },
    "summary": { "type": "object", "required": ["total", "passed", "semanticFailed", "infraFailed", "successRate", "cases"] },
    "gate": { "type": "object", "additionalProperties": false, "required": ["passed", "failed", "flaky"], "properties": { "passed": { "type": "boolean" }, "failed": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "flaky": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "required": ["caseId", "attempt", "status", "errors", "cleanup", "workspaceMutations", "usage", "forbiddenWrites"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["PASS", "SEMANTIC_FAIL", "INFRA_FAIL"] },
        "infrastructureCode": { "enum": ["PROVIDER_AUTH", "NETWORK", "TIMEOUT", "RPC_PROTOCOL", "CHILD_EXIT", "CLEANUP_FAILURE", "UNCLASSIFIED"] },
        "errors": { "type": "array", "items": { "type": "string" } },
        "retryOf": { "type": "integer", "minimum": 1 },
        "retryReason": { "type": "string", "minLength": 1 },
        "cleanup": { "type": "object" },
        "workspaceMutations": { "type": "object" },
        "usage": { "type": "object", "additionalProperties": false, "required": ["source", "toolCalls", "contextTokens", "totalTokens"], "properties": { "source": { "enum": ["pi-session-stats", "UNAVAILABLE"] }, "toolCalls": { "type": "integer", "minimum": 0 }, "contextTokens": { "type": "integer", "minimum": 0 }, "totalTokens": { "type": "integer", "minimum": 0 } } },
        "forbiddenWrites": { "type": "integer", "minimum": 0 },
        "turns": { "type": "array" }
      }
    }
  }
}
