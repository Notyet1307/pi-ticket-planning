{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/codex-controller-contract-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "commit",
    "sourceManifestDigest",
    "buildDigest",
    "identityDigest",
    "releasePlanVersion",
    "schemaPath",
    "schemaSha256",
    "digestAlgorithm",
    "integrationMode",
    "dispatcherQualified",
    "operatorStartRequired"
  ],
  "properties": {
    "schema": { "const": "pi-ticket-planning:codex-controller-contract:v1" },
    "repository": { "const": "https://github.com/Notyet1307/herdr-codex-controller.git" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceManifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "buildDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identityDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "releasePlanVersion": { "const": 2 },
    "schemaPath": { "const": "schemas/release-plan-v2.schema.json" },
    "schemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digestAlgorithm": { "const": "canonical-json-v1+sha256-hex" },
    "integrationMode": { "const": "release-plan-v2-direct" },
    "dispatcherQualified": { "const": false },
    "operatorStartRequired": { "const": true }
  }
}
