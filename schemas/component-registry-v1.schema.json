{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/component-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "components"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:component-registry:v1" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["actor", "command", "external", "module", "skill", "workflow"] },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
          "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    }
  }
}
