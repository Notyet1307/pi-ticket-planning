{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/execution-handoff-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "repo",
    "target",
    "planFingerprint",
    "freshnessDigest",
    "decisionManifestDigest",
    "predecessorReceiptDigest",
    "dependencyHandoffDigests",
    "oracleBindingDigests",
    "controllerPlanDigest",
    "controllerConfigDigest",
    "controllerRevision",
    "controllerSourceManifestDigest",
    "controllerBuildDigest",
    "controllerIdentityDigest",
    "controllerProvenanceDigest",
    "approvalId",
    "verifiedAt",
    "releasePlanDigest",
    "digest"
  ],
  "properties": {
    "schema": { "const": "pi-ticket-planning:execution-handoff-receipt:v1" },
    "status": { "const": "COMPLETE" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "target": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "planFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "freshnessDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "decisionManifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "predecessorReceiptDigest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      ]
    },
    "dependencyHandoffDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "oracleBindingDigests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "digest"],
        "properties": {
          "issue": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "controllerPlanDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "controllerConfigDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "controllerRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "controllerSourceManifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "controllerBuildDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "controllerIdentityDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "controllerProvenanceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvalId": { "type": "string", "pattern": "^F-[A-Za-z0-9._:-]{1,126}$" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "releasePlanDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
