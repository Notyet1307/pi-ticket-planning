{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/e2e-report-v2.schema.json",
  "allOf": [{ "$ref": "report-metadata-v1.schema.json" }],
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schema", "runId", "repo", "resourceTag", "status", "reasonCode", "scenarios", "metrics", "setup", "harnessEvidence", "providerEvidence", "githubAppEvidence", "cleanup", "recoveryCommand"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:e2e-report:v2" },
    "tier": { "const": "L3_REAL_DISPOSABLE_INTEGRATION" },
    "runId": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "repo": { "oneOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }, { "type": "null" }] },
    "resourceTag": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "UNTESTED"] },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "scenarios": { "type": "array", "minItems": 18, "maxItems": 1000, "items": { "$ref": "#/$defs/scenario" } },
    "metrics": { "$ref": "#/$defs/metrics" },
    "setup": { "type": "object", "additionalProperties": false, "required": ["status", "externalWrites", "evidenceDigests"], "properties": { "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] }, "externalWrites": { "type": "integer", "minimum": 0 }, "evidenceDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/digest" } } } },
    "harnessEvidence": { "$ref": "#/$defs/harnessEvidence" },
    "providerEvidence": { "$ref": "#/$defs/providerEvidence" },
    "githubAppEvidence": { "$ref": "#/$defs/githubAppEvidence" },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["status", "deleted", "remaining"], "properties": { "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] }, "deleted": { "type": "integer", "minimum": 0 }, "remaining": { "type": "integer", "minimum": 0 }, "recoveryCommand": { "type": ["string", "null"] }, "recoveredByAnotherProcess": { "type": "boolean" } } },
    "recoveryCommand": { "type": ["string", "null"] }
  },
  "$defs": {
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scenarioId", "ordinal", "evidenceClass", "expectedStatus", "expectedReasonCode", "expectedExternalWrites", "expectedRecovery", "expectedCleanup", "status", "reasonCode", "durationMs", "retries", "recoveryAttempted", "metrics", "evidenceVerified", "evidenceDigests"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "scenarioId": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "evidenceClass": { "enum": ["REAL_EXTERNAL", "REAL_PROVIDER", "FAULT_INJECTED", "DETERMINISTIC_ONLY"] },
        "expectedStatus": { "type": "string", "minLength": 1 },
        "expectedReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
        "expectedExternalWrites": { "type": "integer", "minimum": 0 },
        "expectedRecovery": { "type": "boolean" },
        "expectedCleanup": { "type": "boolean" },
        "status": { "enum": ["PASS", "RECOVERED", "EXPECTED_BLOCK", "FAIL", "UNTESTED"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
        "durationMs": { "type": "number", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "recoveryAttempted": { "type": "boolean" },
        "evidenceVerified": { "type": "boolean" },
        "metrics": { "type": "object", "additionalProperties": false, "required": ["unauthorizedWrites", "externalWrites", "githubApiCalls", "modelTurns", "toolCalls", "contextTokens"], "properties": { "unauthorizedWrites": { "type": "integer", "minimum": 0 }, "externalWrites": { "type": "integer", "minimum": 0 }, "githubApiCalls": { "type": "integer", "minimum": 0 }, "modelTurns": { "type": "integer", "minimum": 0 }, "toolCalls": { "type": "integer", "minimum": 0 }, "contextTokens": { "type": "integer", "minimum": 0 } } },
        "evidenceDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/digest" } }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["executions", "first_pass_success_rate", "eventual_success_rate", "retry_rate", "unclassified_failure_rate", "unauthorized_write_count", "recovery_attempts", "recovery_success_rate", "cleanup_success_rate", "p50_duration_ms", "p95_duration_ms", "model_turns", "tool_calls", "context_tokens", "github_api_calls"],
      "properties": {
        "executions": { "type": "integer", "minimum": 0 }, "first_pass_success_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "eventual_success_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "retry_rate": { "type": "number", "minimum": 0 }, "unclassified_failure_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "unauthorized_write_count": { "type": "integer", "minimum": 0 }, "recovery_attempts": { "type": "integer", "minimum": 0 }, "recovery_success_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "cleanup_success_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "p50_duration_ms": { "type": ["number", "null"], "minimum": 0 }, "p95_duration_ms": { "type": ["number", "null"], "minimum": 0 }, "model_turns": { "type": "integer", "minimum": 0 }, "tool_calls": { "type": "integer", "minimum": 0 }, "context_tokens": { "type": "integer", "minimum": 0 }, "github_api_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "harnessEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "preflight", "final", "evidenceDigests"],
      "properties": {
        "status": { "enum": ["PASS", "PARTIAL", "BLOCKED", "UNTESTED"] },
        "preflight": { "type": "object", "additionalProperties": false, "required": ["exactTarget", "readiness", "validation", "deliveryGate", "noBypass"], "properties": { "exactTarget": { "type": "boolean" }, "readiness": { "type": "boolean" }, "validation": { "type": "boolean" }, "deliveryGate": { "type": "boolean" }, "noBypass": { "type": "boolean" } } },
        "final": { "type": "object", "additionalProperties": false, "required": ["claimDetection", "terminalOutcome"], "properties": { "claimDetection": { "type": "boolean" }, "terminalOutcome": { "type": "boolean" } } },
        "evidenceDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/digest" } }
      }
    },
    "providerEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "childResult", "freshContext", "strictSchema", "namedSession", "persistedSession", "exactIdFileResume", "sessionResume", "timeoutCancellation", "evidenceDigests"],
      "properties": {
        "status": { "enum": ["PASS", "PARTIAL", "BLOCKED", "UNTESTED"] },
        "childResult": { "type": "boolean" }, "freshContext": { "type": "boolean" }, "strictSchema": { "type": "boolean" }, "namedSession": { "type": "boolean" }, "persistedSession": { "type": "boolean" }, "exactIdFileResume": { "type": "boolean" }, "sessionResume": { "type": "boolean" }, "timeoutCancellation": { "type": "boolean" },
        "evidenceDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/digest" } }
      }
    },
    "githubAppEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "appSlug", "installationIdentityDigest", "targetRepo", "permissions", "writeActorReadback", "evidenceDigests"],
      "properties": {
        "status": { "enum": ["PASS", "BLOCKED", "UNTESTED"] },
        "appSlug": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]{1,100}$" },
        "installationIdentityDigest": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/digest" }, { "type": "null" }] },
        "targetRepo": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "permissions": {
          "type": "object", "additionalProperties": false,
          "required": ["metadata", "issues", "contents", "administration"],
          "properties": { "metadata": { "enum": ["read", "none"] }, "issues": { "enum": ["write", "none"] }, "contents": { "const": "none" }, "administration": { "const": "none" } }
        },
        "writeActorReadback": { "type": "boolean" },
        "evidenceDigests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/digest" } }
      }
    }
  }
}
