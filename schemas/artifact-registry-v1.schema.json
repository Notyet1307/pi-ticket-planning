{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/artifact-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifacts"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:artifact-registry:v1" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "name", "schemaIdentity", "schemaPath", "currentMajor", "readableMajors", "writer", "readers", "fingerprintAlgorithm", "migrationPath"],
        "properties": {
          "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "schemaIdentity": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*:v[1-9][0-9]*$" },
          "schemaPath": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
          "schemaPaths": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" } },
          "currentMajor": { "type": "integer", "minimum": 1 },
          "readableMajors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
          "writer": { "type": "string", "minLength": 1, "maxLength": 128 },
          "readers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "fingerprintAlgorithm": { "type": "string", "minLength": 1, "maxLength": 128 },
          "migrationPath": { "type": ["string", "null"], "maxLength": 512 }
        }
      }
    }
  }
}
