{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/planning-case-event-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "sequence", "caseId", "target", "type", "at", "data", "transactionId", "previousDigest", "digest"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:planning-case-event:v2" },
    "id": { "type": "string", "pattern": "^E-[A-Za-z0-9._:-]{1,126}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "caseId": { "type": "string", "pattern": "^PC-[A-Za-z0-9._-]{1,96}$" },
    "target": { "$ref": "common-v1.schema.json#/$defs/target" },
    "type": { "enum": ["CASE_CREATED", "CHECKPOINT_TRANSITIONED", "CANDIDATE_SELECTED", "CANDIDATE_EXCLUDED", "DECISION_RECORDED", "UNKNOWN_RECORDED", "UNKNOWN_RESOLVED", "ASSUMPTION_RECORDED", "ASSUMPTION_REVISED", "EVIDENCE_METHOD_SET", "EVIDENCE_RECORDED", "FACT_ATTACHED", "FACT_CONSUMED", "BLOCKER_SET", "BLOCKER_CLEARED", "NEXT_ACTION_SET", "BINDING_SET", "BINDING_CLEARED", "APPROVAL_ADDED", "APPROVAL_CONSUMED", "ADMISSION_TRANSACTION_CHANGED", "OUTCOME_INGESTED", "LEARNING_DECISION_RECORDED", "CASE_ABANDONED"] },
    "at": { "$ref": "common-v1.schema.json#/$defs/time" },
    "data": { "type": "object" },
    "transactionId": { "type": "string", "pattern": "^TX-[A-Za-z0-9._:-]{1,125}$" },
    "previousDigest": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/digest" }, { "type": "null" }] },
    "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
  },
  "oneOf": [
    { "$ref": "#/$defs/caseCreated" },
    { "$ref": "#/$defs/checkpointTransitioned" },
    { "$ref": "#/$defs/candidateSelected" },
    { "$ref": "#/$defs/candidateExcluded" },
    { "$ref": "#/$defs/decisionRecorded" },
    { "$ref": "#/$defs/unknownRecorded" },
    { "$ref": "#/$defs/unknownResolved" },
    { "$ref": "#/$defs/assumptionRecorded" },
    { "$ref": "#/$defs/assumptionRevised" },
    { "$ref": "#/$defs/evidenceMethodSet" },
    { "$ref": "#/$defs/evidenceRecorded" },
    { "$ref": "#/$defs/factAttached" },
    { "$ref": "#/$defs/factConsumed" },
    { "$ref": "#/$defs/blockerSet" },
    { "$ref": "#/$defs/blockerCleared" },
    { "$ref": "#/$defs/nextActionSet" },
    { "$ref": "#/$defs/bindingSet" },
    { "$ref": "#/$defs/bindingCleared" },
    { "$ref": "#/$defs/approvalAdded" },
    { "$ref": "#/$defs/approvalConsumed" },
    { "$ref": "#/$defs/admissionTransactionChanged" },
    { "$ref": "#/$defs/outcomeIngested" },
    { "$ref": "#/$defs/learningRecorded" },
    { "$ref": "#/$defs/caseAbandoned" }
  ],
  "$defs": {
    "caseCreated": { "properties": { "type": { "const": "CASE_CREATED" }, "data": { "type": "object", "additionalProperties": false, "required": ["snapshot"], "properties": { "snapshot": { "$ref": "planning-case-v2.schema.json" } } } } },
    "checkpointTransitioned": { "properties": { "type": { "const": "CHECKPOINT_TRANSITIONED" }, "data": { "type": "object", "additionalProperties": false, "required": ["checkpoint", "facts", "rebind", "mutationId", "nextAction"], "properties": { "checkpoint": { "$ref": "checkpoint-v2.schema.json" }, "facts": { "type": "array", "items": { "$ref": "fact-attestation-v1.schema.json" } }, "rebind": { "type": "boolean" }, "mutationId": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/safeText" }, { "type": "null" }] }, "nextAction": { "$ref": "planning-case-v2.schema.json#/$defs/nextAction" } } } } },
    "candidateSelected": { "properties": { "type": { "const": "CANDIDATE_SELECTED" }, "data": { "$ref": "#/$defs/candidateData" } } },
    "candidateExcluded": { "properties": { "type": { "const": "CANDIDATE_EXCLUDED" }, "data": { "$ref": "#/$defs/candidateData" } } },
    "candidateData": { "type": "object", "additionalProperties": false, "required": ["candidate"], "properties": { "candidate": { "$ref": "planning-case-v2.schema.json#/$defs/candidate" } } },
    "decisionRecorded": { "properties": { "type": { "const": "DECISION_RECORDED" }, "data": { "type": "object", "additionalProperties": false, "required": ["decision"], "properties": { "decision": { "$ref": "planning-case-v2.schema.json#/$defs/decision" } } } } },
    "unknownRecorded": { "properties": { "type": { "const": "UNKNOWN_RECORDED" }, "data": { "type": "object", "additionalProperties": false, "required": ["unknown"], "properties": { "unknown": { "$ref": "planning-case-v2.schema.json#/$defs/unknown" } } } } },
    "unknownResolved": { "properties": { "type": { "const": "UNKNOWN_RESOLVED" }, "data": { "type": "object", "additionalProperties": false, "required": ["unknownId", "resolution", "evidenceDigest"], "properties": { "unknownId": { "$ref": "common-v1.schema.json#/$defs/safeText" }, "resolution": { "$ref": "common-v1.schema.json#/$defs/safeMultilineText" }, "evidenceDigest": { "$ref": "common-v1.schema.json#/$defs/digest" } } } } },
    "assumptionRecorded": { "properties": { "type": { "const": "ASSUMPTION_RECORDED" }, "data": { "type": "object", "additionalProperties": false, "required": ["assumption"], "properties": { "assumption": { "$ref": "planning-case-v2.schema.json#/$defs/assumption" } } } } },
    "assumptionRevised": { "properties": { "type": { "const": "ASSUMPTION_REVISED" }, "data": { "type": "object", "additionalProperties": false, "required": ["assumptionId", "statement", "evidenceDigest"], "properties": { "assumptionId": { "$ref": "common-v1.schema.json#/$defs/safeText" }, "statement": { "$ref": "common-v1.schema.json#/$defs/safeMultilineText" }, "evidenceDigest": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/digest" }, { "type": "null" }] } } } } },
    "evidenceMethodSet": { "properties": { "type": { "const": "EVIDENCE_METHOD_SET" }, "data": { "type": "object", "additionalProperties": false, "required": ["method"], "properties": { "method": { "$ref": "planning-case-v2.schema.json#/$defs/evidenceMethod" } } } } },
    "evidenceRecorded": { "properties": { "type": { "const": "EVIDENCE_RECORDED" }, "data": { "type": "object", "additionalProperties": false, "required": ["evidence"], "properties": { "evidence": { "$ref": "planning-case-v2.schema.json#/$defs/evidence" } } } } },
    "factAttached": { "properties": { "type": { "const": "FACT_ATTACHED" }, "data": { "type": "object", "additionalProperties": false, "required": ["fact"], "properties": { "fact": { "$ref": "fact-attestation-v1.schema.json" } } } } },
    "factConsumed": { "properties": { "type": { "const": "FACT_CONSUMED" }, "data": { "type": "object", "additionalProperties": false, "required": ["factId", "mutationId"], "properties": { "factId": { "type": "string", "pattern": "^F-[A-Za-z0-9._:-]{1,126}$" }, "mutationId": { "$ref": "common-v1.schema.json#/$defs/safeText" } } } } },
    "blockerSet": { "properties": { "type": { "const": "BLOCKER_SET" }, "data": { "type": "object", "additionalProperties": false, "required": ["blocker"], "properties": { "blocker": { "$ref": "planning-case-v2.schema.json#/$defs/blocker" } } } } },
    "blockerCleared": { "properties": { "type": { "const": "BLOCKER_CLEARED" }, "data": { "$ref": "#/$defs/idData" } } },
    "nextActionSet": { "properties": { "type": { "const": "NEXT_ACTION_SET" }, "data": { "type": "object", "additionalProperties": false, "required": ["nextAction"], "properties": { "nextAction": { "$ref": "planning-case-v2.schema.json#/$defs/nextAction" } } } } },
    "bindingSet": { "properties": { "type": { "const": "BINDING_SET" }, "data": { "type": "object", "additionalProperties": false, "required": ["name", "binding"], "properties": { "name": { "enum": ["source", "release", "spec", "graph", "policy", "harness", "capability", "outcome", "session", "reviewer"] }, "binding": { "type": "object" } } } } },
    "bindingCleared": { "properties": { "type": { "const": "BINDING_CLEARED" }, "data": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "enum": ["source", "release", "spec", "graph", "policy", "harness", "capability", "outcome", "session", "reviewer"] } } } } },
    "approvalAdded": { "properties": { "type": { "const": "APPROVAL_ADDED" }, "data": { "type": "object", "additionalProperties": false, "required": ["approval"], "properties": { "approval": { "$ref": "fact-attestation-v1.schema.json" } } } } },
    "approvalConsumed": { "properties": { "type": { "const": "APPROVAL_CONSUMED" }, "data": { "$ref": "#/$defs/idData" } } },
    "admissionTransactionChanged": { "properties": { "type": { "const": "ADMISSION_TRANSACTION_CHANGED" }, "data": { "type": "object", "additionalProperties": false, "required": ["transaction"], "properties": { "transaction": { "$ref": "admission-transaction-v1.schema.json" } } } } },
    "outcomeIngested": { "properties": { "type": { "const": "OUTCOME_INGESTED" }, "data": { "type": "object", "additionalProperties": false, "required": ["receipt"], "properties": { "receipt": { "$ref": "outcome-receipt-v1.schema.json" } } } } },
    "learningRecorded": { "properties": { "type": { "const": "LEARNING_DECISION_RECORDED" }, "data": { "type": "object", "additionalProperties": false, "required": ["learning"], "properties": { "learning": { "$ref": "planning-case-v2.schema.json#/$defs/learning" } } } } },
    "caseAbandoned": { "properties": { "type": { "const": "CASE_ABANDONED" }, "data": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "$ref": "common-v1.schema.json#/$defs/safeMultilineText" } } } } },
    "idData": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "common-v1.schema.json#/$defs/safeText" } } }
  }
}
