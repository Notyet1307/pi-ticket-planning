{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/capability-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "observedAt", "expiresAt", "pi", "subagent", "provider", "profileDigest", "harness", "repo", "capabilities", "digest"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:capability-receipt:v1" },
    "subject": { "$ref": "common-v1.schema.json#/$defs/subject" },
    "observedAt": { "$ref": "common-v1.schema.json#/$defs/time" },
    "expiresAt": { "$ref": "common-v1.schema.json#/$defs/time" },
    "pi": { "$ref": "#/$defs/executable" },
    "subagent": { "type": "object", "required": ["version"] },
    "provider": { "type": "object", "required": ["name", "model"] },
    "profileDigest": { "$ref": "common-v1.schema.json#/$defs/digest" },
    "harness": { "type": ["object", "null"] },
    "repo": { "type": "object", "required": ["target", "baseSha"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reasonCode", "evidence"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
          "status": { "enum": ["SUPPORTED", "DEGRADED", "BLOCKED", "UNTESTED"] },
          "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
          "evidence": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
  },
  "$defs": {
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
      }
    }
  }
}
