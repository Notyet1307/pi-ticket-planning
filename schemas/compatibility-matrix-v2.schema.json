{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/compatibility-matrix-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "defaultStatus", "entries"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:compatibility-matrix:v2" },
    "defaultStatus": { "const": "UNTESTED" },
    "entries": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["piVersion", "piDigest", "subagentVersion", "provider", "model", "thinking", "profileDigest", "harnessVersion", "harnessDigest", "packageCommit", "observedAt", "expiresAt", "status", "reasonCode", "evidence"],
        "properties": {
          "piVersion": { "type": "string", "minLength": 1 },
          "piDigest": { "$ref": "common-v1.schema.json#/$defs/digest" },
          "subagentVersion": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "thinking": { "type": "string", "minLength": 1 },
          "profileDigest": { "$ref": "common-v1.schema.json#/$defs/digest" },
          "harnessVersion": { "type": "string", "minLength": 1 },
          "harnessDigest": { "$ref": "common-v1.schema.json#/$defs/digest" },
          "packageCommit": { "$ref": "common-v1.schema.json#/$defs/gitSha" },
          "observedAt": { "$ref": "common-v1.schema.json#/$defs/time" },
          "expiresAt": { "$ref": "common-v1.schema.json#/$defs/time" },
          "status": { "enum": ["SUPPORTED", "DEGRADED", "BLOCKED", "UNTESTED"] },
          "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "digest"], "properties": { "kind": { "enum": ["active-capability", "l2-model", "l3-e2e", "l4-qualification"] }, "digest": { "$ref": "common-v1.schema.json#/$defs/digest" } } } }
        }
      }
    }
  }
}
