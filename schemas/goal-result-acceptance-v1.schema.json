{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/goal-result-acceptance-v1.schema.json",
  "title": "Accepted Goal Release Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result", "handoff", "acceptedAt", "digest"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:goal-result-acceptance:v1" },
    "result": { "$ref": "goal-release-result-v1.schema.json" },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "channel", "runnerRef"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "channel": { "enum": ["GOAL_LOCAL", "GOAL_REMOTE"] },
        "runnerRef": { "type": "string", "pattern": "^[a-z0-9._-]{1,80}$" }
      }
    },
    "acceptedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
