{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/workflow-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "lanes", "identityPatterns", "stages", "allowedTransitions", "transitionRequirements", "rebindTransitions", "verdictRequirements"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:workflow:v1" },
    "version": { "const": 1 },
    "lanes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "identityPatterns": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
    "stages": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object" } },
    "allowedTransitions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "transitionRequirements": { "type": "array", "items": { "type": "object" } },
    "rebindTransitions": { "type": "array", "items": { "type": "object" } },
    "verdictRequirements": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
  }
}
