{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/protocol-rules-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rules"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:protocol-rules:v1" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownerPath", "kind", "status", "since", "sourceDecision"],
        "properties": {
          "id": { "type": "string", "pattern": "^PTP-[A-Z]+-[0-9]{3}$" },
          "ownerPath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "kind": { "enum": ["authority", "workflow", "mutation", "state", "security"] },
          "status": { "enum": ["draft", "active", "deprecated"] },
          "since": { "type": "string", "minLength": 1, "maxLength": 64 },
          "sourceDecision": { "type": "string", "minLength": 1, "maxLength": 256 },
          "replacement": { "type": "string", "pattern": "^PTP-[A-Z]+-[0-9]{3}$" }
        }
      }
    }
  }
}
