{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/codex-controller-contract-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "commit", "sourceManifestDigest", "buildDigest", "identityDigest", "releasePlanVersion", "schemaPath", "schemaSha256", "configVersion", "configSchemaPath", "configSchemaSha256", "completionVersion", "completionSchemaPath", "completionSchemaSha256", "historicalCompletionSchemas", "controllerProvenanceVersion", "jobStateVersion", "requiredCheckContractVersion", "mergeAuthorityContract", "reviewPolicy", "controllerIdentityHistoryPath", "controllerIdentityHistorySha256", "controllerIdentityHistoryDigest", "controllerIdentityHistorySchemaPath", "controllerIdentityHistorySchemaSha256", "controllerRuntimeContractLockPath", "controllerRuntimeContractLockSha256", "controllerRuntimeContractLockDigest", "trustRegistryPath", "trustRegistryDigest", "riskClassRegistryPath", "riskClassRegistrySha256", "riskClassRegistryDigest", "riskClassRegistrySourceCommit", "digestAlgorithm", "integrationMode", "dispatcherQualified", "operatorStartRequired", "digest"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:codex-controller-contract:v2" },
    "repository": { "const": "https://github.com/Notyet1307/herdr-codex-controller.git" },
    "commit": { "$ref": "#/$defs/revision" },
    "sourceManifestDigest": { "$ref": "#/$defs/hex" },
    "buildDigest": { "$ref": "#/$defs/hex" },
    "identityDigest": { "$ref": "#/$defs/hex" },
    "releasePlanVersion": { "const": 2 },
    "schemaPath": { "const": "schemas/release-plan-v2.schema.json" },
    "schemaSha256": { "$ref": "#/$defs/hex" },
    "configVersion": { "const": 3 },
    "configSchemaPath": { "const": "schemas/controller-config.schema.json" },
    "configSchemaSha256": { "$ref": "#/$defs/hex" },
    "completionVersion": { "const": 3 },
    "completionSchemaPath": { "const": "schemas/release-completion-v3.schema.json" },
    "completionSchemaSha256": { "$ref": "#/$defs/hex" },
    "historicalCompletionSchemas": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": { "type": "object", "additionalProperties": false, "required": ["version", "path", "sha256"], "properties": { "version": { "type": "integer", "minimum": 1 }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hex" } } }
    },
    "controllerProvenanceVersion": { "const": 3 },
    "jobStateVersion": { "const": 4 },
    "requiredCheckContractVersion": { "const": 1 },
    "mergeAuthorityContract": { "const": { "version": 1, "mode": "controller-auto-merge", "quarantine": "delete-exact-head-branch" } },
    "reviewPolicy": { "const": { "enabled": true, "blockingSeverities": ["critical", "major"] } },
    "controllerIdentityHistoryPath": { "const": "contracts/controller-identity-history.json" },
    "controllerIdentityHistorySha256": { "$ref": "#/$defs/hex" },
    "controllerIdentityHistoryDigest": { "$ref": "#/$defs/prefixed" },
    "controllerIdentityHistorySchemaPath": { "const": "schemas/controller-identity-history-v1.schema.json" },
    "controllerIdentityHistorySchemaSha256": { "$ref": "#/$defs/hex" },
    "controllerRuntimeContractLockPath": { "const": "contracts/runtime-contract-lock.json" },
    "controllerRuntimeContractLockSha256": { "$ref": "#/$defs/hex" },
    "controllerRuntimeContractLockDigest": { "$ref": "#/$defs/prefixed" },
    "trustRegistryPath": { "const": "compatibility/codex-controller-trust.json" },
    "trustRegistryDigest": { "$ref": "#/$defs/prefixed" },
    "riskClassRegistryPath": { "const": "contracts/risk-class-registry.json" },
    "riskClassRegistrySha256": { "$ref": "#/$defs/hex" },
    "riskClassRegistryDigest": { "$ref": "#/$defs/prefixed" },
    "riskClassRegistrySourceCommit": { "$ref": "#/$defs/revision" },
    "digestAlgorithm": { "const": "utf16-code-unit-canonical-json-v1+sha256-hex" },
    "integrationMode": { "const": "release-plan-v2-direct" },
    "dispatcherQualified": { "const": false },
    "operatorStartRequired": { "const": true },
    "digest": { "$ref": "#/$defs/prefixed" }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prefixed": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
