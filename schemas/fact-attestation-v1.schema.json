{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/fact-attestation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "fact", "value", "subject", "source", "observedAt", "expiresAt", "evidence"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:fact-attestation:v1" },
    "id": { "type": "string", "pattern": "^F-[A-Za-z0-9._:-]{1,126}$" },
    "fact": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)+$" },
    "value": {},
    "subject": { "$ref": "common-v1.schema.json#/$defs/subject" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producer", "producerVersion", "producerDigest"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" },
        "producer": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$" },
        "producerVersion": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000\\r\\n]+$" },
        "producerDigest": { "$ref": "common-v1.schema.json#/$defs/digest" }
      }
    },
    "observedAt": { "$ref": "common-v1.schema.json#/$defs/time" },
    "expiresAt": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/time" }, { "type": "null" }] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "digest"],
      "properties": {
        "kind": { "enum": ["receipt", "artifact", "tracker", "operator", "harness", "capability"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000\\r\\n]+$" },
        "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
      }
    }
  }
}
