{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/admission-review-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewer", "reviewedAt", "source", "axes", "graphVerdict", "candidates", "inputBinding"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:admission-review:v1" },
    "reviewer": { "const": "ticket-readiness-reviewer" },
    "reviewedAt": { "$ref": "common-v1.schema.json#/$defs/time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "revision", "baseSha"],
      "properties": {
        "identity": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "revision": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "baseSha": { "$ref": "common-v1.schema.json#/$defs/gitSha" },
        "specContentHash": { "$ref": "common-v1.schema.json#/$defs/digest" }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateReadiness", "contextQuality", "deliveryGraph", "scenarioCoverage", "walkingSkeleton", "strictFrontier", "executionLane", "inputBinding"],
      "properties": {
        "candidateReadiness": { "$ref": "#/$defs/axis" },
        "contextQuality": { "$ref": "#/$defs/axis" },
        "deliveryGraph": { "$ref": "#/$defs/axis" },
        "scenarioCoverage": { "$ref": "#/$defs/axis" },
        "walkingSkeleton": { "$ref": "#/$defs/axis" },
        "strictFrontier": { "$ref": "#/$defs/axis" },
        "executionLane": { "$ref": "#/$defs/axis" },
        "inputBinding": { "$ref": "#/$defs/axis" }
      }
    },
    "graphVerdict": { "enum": ["READY", "NEEDS_INFO"] },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "executionLane", "riskClasses", "riskCount", "primaryVerificationSeams", "scopeBudget", "expectedPaths", "protectedOraclePaths", "oracleBindingDigest", "oracleBindingVerdict", "replanTriggers", "codeHotspotOverlap", "integrationOnlyVerdict", "waiverDigests"],
        "properties": {
          "id": { "$ref": "common-v1.schema.json#/$defs/safeText" },
          "verdict": { "enum": ["READY", "SPLIT", "NEEDS_INFO"] },
          "executionLane": { "enum": ["AGENT", "HUMAN"] },
          "riskClasses": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
          },
          "riskCount": { "type": "integer", "minimum": 0 },
          "primaryVerificationSeams": { "type": "array", "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/safeText" } },
          "scopeBudget": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["maxFiles", "maxChangedLines"],
                "properties": {
                  "maxFiles": { "type": "integer", "minimum": 1 },
                  "maxChangedLines": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          },
          "expectedPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)(?!.*\\*\\*)(?![^/]*\\*)(?!.*[\\\\?\\[\\]{}\\u0000\\r\\n])[^/]+(?:/[^/]+)*$"
            }
          },
          "protectedOraclePaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/safeText" } },
          "oracleBindingDigest": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/digest" }, { "type": "null" }] },
          "oracleBindingVerdict": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
          "replanTriggers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" } },
          "codeHotspotOverlap": { "type": "array", "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/safeText" } },
          "integrationOnlyVerdict": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
          "waiverDigests": { "type": "array", "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/digest" } }
        }
      }
    },
    "inputBinding": { "$ref": "admission-review-binding-v1.schema.json" }
  },
  "$defs": {
    "axis": { "enum": ["PASS", "FAIL", "NEEDS_INFO"] }
  }
}
