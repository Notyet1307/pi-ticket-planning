{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/risk-class-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classes", "aliases", "splitCombinations", "digest"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:risk-class-registry:v1" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
    },
    "aliases": { "type": "object", "maxProperties": 0 },
    "splitCombinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
      }
    },
    "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
  }
}
