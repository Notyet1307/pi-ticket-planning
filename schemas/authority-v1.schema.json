{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/authority-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "factDefaults", "facts", "mutations"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:authority:v1" },
    "version": { "const": 1 },
    "factDefaults": { "type": "object" },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "owner", "sources"],
        "properties": {
          "kind": { "enum": ["IMMUTABLE_FACT", "LIVE_FACT", "HUMAN_APPROVAL", "CAPABILITY_FACT", "TRACKER_FACT", "HARNESS_FACT"] },
          "owner": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "freshness": { "type": "object" },
          "crossRevision": { "type": "boolean" },
          "reusable": { "type": "boolean" }
        }
      }
    },
    "mutations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["strict", "actor", "sourceStage", "sourceVerdict", "targetStage", "targetVerdict", "approvalFact", "requiredFacts", "producesFacts", "postconditions"]
      }
    }
  }
}
