{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/postcondition-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verifiers"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:postcondition-registry:v1" },
    "verifiers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "export"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
        }
      }
    }
  }
}
