{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/delivery-release-graph-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "executable", "readinessState", "releaseId", "releaseOrdinal", "planningBaseSha", "executionBaseSha", "roadmapDigest", "predecessorReleaseId", "predecessorReceipt", "specAcceptance", "decisionManifestDigest", "source", "scenarios", "children", "walkingSkeleton"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:delivery-release-graph:v3" },
    "kind": { "const": "EXECUTABLE_RELEASE" },
    "executable": { "const": true },
    "readinessState": { "enum": ["PLANNED", "SPEC_ACCEPTED", "ORACLES_BOUND", "GRAPH_REVIEWED", "HANDOFF_APPROVED", "HANDOFF_READY"] },
    "releaseId": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "releaseOrdinal": { "type": "integer", "minimum": 1 },
    "planningBaseSha": { "$ref": "common-v1.schema.json#/$defs/gitSha" },
    "executionBaseSha": { "$ref": "common-v1.schema.json#/$defs/gitSha" },
    "roadmapDigest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common-v1.schema.json#/$defs/digest" }
      ]
    },
    "predecessorReleaseId": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common-v1.schema.json#/$defs/safeText" }
      ]
    },
    "predecessorReceipt": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "release-predecessor-receipt-v1.schema.json" }
      ]
    },
    "specAcceptance": { "$ref": "spec-acceptance-v1.schema.json" },
    "decisionManifestDigest": { "$ref": "common-v1.schema.json#/$defs/digest" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "revision", "specContentHash"],
      "properties": {
        "identity": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "revision": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "specContentHash": { "$ref": "common-v1.schema.json#/$defs/digest" }
      }
    },
    "childPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChildren"],
      "properties": {
        "maxChildren": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/child" }
    },
    "walkingSkeleton": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "behavior", "entry", "exit", "releaseSignal", "smallestLoop"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
        "behavior": { "$ref": "common-v1.schema.json#/$defs/safeMultilineText" },
        "entry": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "exit": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "releaseSignal": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "smallestLoop": { "type": "boolean" }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "coverageRole", "sourceScenarios", "blockedBy", "externalBlockers", "bodyHash", "startingState", "primaryVerification", "primaryVerificationSeams", "executionLane", "implementationOwner", "riskClasses", "scopeBudget", "expectedPaths", "protectedPaths", "replanTriggers", "oracleBindingDigest", "integrationOnly", "waiverDigests"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "title": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "coverageRole": { "enum": ["DIRECT", "ENABLER"] },
        "sourceScenarios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "blockedBy": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "externalBlockers": { "type": "array", "maxItems": 0 },
        "bodyHash": { "$ref": "common-v1.schema.json#/$defs/digest" },
        "startingState": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "primaryVerification": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "primaryVerificationSeams": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "common-v1.schema.json#/$defs/safeText" }
        },
        "executionLane": { "const": "AGENT" },
        "implementationOwner": { "$ref": "common-v1.schema.json#/$defs/safeText" },
        "riskClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        },
        "scopeBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxFiles", "maxChangedLines"],
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maxChangedLines": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        "expectedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "common-v1.schema.json#/$defs/safeText" }
        },
        "protectedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "common-v1.schema.json#/$defs/safeText" }
        },
        "replanTriggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
        },
        "oracleBindingDigest": { "$ref": "common-v1.schema.json#/$defs/digest" },
        "integrationOnly": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["noNewProductBehavior", "noSchemaChanges", "noDuplicatedProductionLogic", "missingBehavior"],
              "properties": {
                "noNewProductBehavior": { "type": "boolean" },
                "noSchemaChanges": { "type": "boolean" },
                "noDuplicatedProductionLogic": { "type": "boolean" },
                "missingBehavior": { "type": "string" }
              }
            }
          ]
        },
        "waiverDigests": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "common-v1.schema.json#/$defs/digest" }
        },
        "downstreamConsumers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "exitCondition": { "$ref": "common-v1.schema.json#/$defs/safeText" }
      }
    }
  }
}
