{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/oracle-verifier-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "oracleId", "command", "packageScript", "files", "digest"],
  "properties": {
    "schema": { "const": "herdr-codex-controller:oracle-verifier-manifest:v1" },
    "oracleId": { "type": "string", "pattern": "^O(?:0[1-9][0-9]*|[1-9][0-9]*)$" },
    "command": { "type": "string", "pattern": "^npm run verify:[A-Za-z0-9:_-]+$", "maxLength": 512 },
    "packageScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definitionSha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^verify:[A-Za-z0-9:_-]+$", "maxLength": 256 },
        "definitionSha256": { "$ref": "common-v1.schema.json#/$defs/digest" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byteCount"],
        "properties": {
          "path": { "$ref": "common-v1.schema.json#/$defs/safeText" },
          "sha256": { "$ref": "common-v1.schema.json#/$defs/digest" },
          "byteCount": { "type": "integer", "minimum": 0, "maximum": 67108864 }
        }
      }
    },
    "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
  }
}
