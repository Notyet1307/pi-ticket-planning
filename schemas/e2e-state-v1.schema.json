{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/e2e-state-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repo", "runId", "resourceTag", "label", "actor", "startedAt", "status", "cleanupAt", "controlIssue", "resources", "digest"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:e2e-state:v1" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "runId": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "resourceTag": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "label": { "type": "string", "pattern": "^ptp-e2e-[a-f0-9]{20}$" },
    "actor": { "$ref": "common-v1.schema.json#/$defs/safeText" },
    "startedAt": { "$ref": "common-v1.schema.json#/$defs/time" },
    "status": { "enum": ["ACTIVE", "CLEANUP_COMMITTING", "COMPLETE"] },
    "cleanupAt": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/time" }, { "type": "null" }] },
    "controlIssue": { "type": ["integer", "null"], "minimum": 1 },
    "resources": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["marker", "titles", "number", "actor", "createdAt"],
        "properties": {
          "marker": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "titles": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "common-v1.schema.json#/$defs/safeText" } },
          "number": { "type": ["integer", "null"], "minimum": 1 },
          "actor": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/safeText" }, { "type": "null" }] },
          "createdAt": { "oneOf": [{ "$ref": "common-v1.schema.json#/$defs/time" }, { "type": "null" }] }
        }
      }
    },
    "digest": { "$ref": "common-v1.schema.json#/$defs/digest" }
  }
}
