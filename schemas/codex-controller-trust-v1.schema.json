{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/codex-controller-trust-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "digestAlgorithm", "activeIdentityDigest", "entries", "digest"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:controller-trust-registry:v1" },
    "digestAlgorithm": { "const": "utf16-code-unit-canonical-json-v1+sha256-hex" },
    "activeIdentityDigest": { "$ref": "#/$defs/hex" },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identity", "ownedSchemas", "qualificationStatus", "activatedAt", "historyDigest", "qualificationDigest", "revocation", "active"],
        "properties": {
          "identity": { "$ref": "#/$defs/identity" },
          "ownedSchemas": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["schema", "sha256"], "properties": { "schema": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/prefixed" } } } },
          "qualificationStatus": { "const": "qualified" },
          "activatedAt": { "type": "string", "format": "date-time" },
          "historyDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/prefixed" }] },
          "qualificationDigest": { "$ref": "#/$defs/prefixed" },
          "revocation": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["revokedAt", "reason"], "properties": { "revokedAt": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "minLength": 1, "maxLength": 2000 } } }] },
          "active": { "type": "boolean" }
        }
      }
    },
    "digest": { "$ref": "#/$defs/prefixed" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prefixed": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identity": { "type": "object", "additionalProperties": false, "required": ["version", "sourceRevision", "sourceManifestDigest", "buildDigest", "digest"], "properties": { "version": { "const": 1 }, "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "sourceManifestDigest": { "$ref": "#/$defs/hex" }, "buildDigest": { "$ref": "#/$defs/hex" }, "digest": { "$ref": "#/$defs/hex" } } }
  }
}
