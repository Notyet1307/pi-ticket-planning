{
  "schema": "pi-ticket-planning:context-routes:v1",
  "rules": [
    { "stages": ["ORIENT"], "manifest": "product-orient.json" },
    { "stages": ["FRAME", "COMMIT"], "manifest": "product-frame.json" },
    { "stages": ["EVIDENCE"], "manifest": "product-evidence-research.json" },
    { "stages": ["SPEC"], "manifest": "delivery-spec.json" },
    { "stages": ["TICKETS"], "manifest": "delivery-tickets.json" },
    { "stages": ["ADMISSION"], "verdicts": ["REVIEW_IN_PROGRESS"], "manifest": "admission-review.json" },
    { "stages": ["ADMISSION"], "verdicts": ["ACTIVATION_AWAITING_CONFIRMATION"], "manifest": "admission-activation.json" },
    { "stages": ["ADMISSION"], "verdicts": ["ADMITTED", "BLOCKED"], "manifest": "product-status.json" },
    { "stages": ["EXECUTION"], "verdicts": ["HANDOFF_READY"], "manifest": "handoff-ready.json" },
    { "stages": ["EXECUTION"], "verdicts": ["IN_PROGRESS", "BLOCKED", "DELIVERED"], "manifest": "execution-outcome.json" },
    { "stages": ["OUTCOME"], "manifest": "execution-outcome.json" }
  ]
}
